{
  "name": "steveobot-minecraft-addons",
  "version": "0.1.0",
  "private": true,
  "description": "A monorepo of custom Minecraft Bedrock Edition add-ons.",
  "license": "MIT",
  "author": "Steven Le",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "build:release": "node tools/build.ts --release",
    "watch": "node tools/watch.ts",
    "deploy": "node tools/deploy.ts",
    "realm": "node tools/realm.ts",
    "package": "node tools/package.ts",
    "validate": "node tools/validate.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tools/tsconfig.json",
    "test": "node --test \"tools/**/*.test.ts\"",
    "clean": "node tools/clean.ts",
    "new": "node tools/new-addon.ts",
    "check": "pnpm run validate && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@minecraft/server": "2.9.0",
    "@minecraft/server-ui": "2.1.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "adm-zip": "^0.5.16",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.0",
    "prismarine-auth": "^3.1.1",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
