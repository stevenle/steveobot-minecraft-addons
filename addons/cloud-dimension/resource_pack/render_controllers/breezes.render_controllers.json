        {
          "*": "Material.breeze_wind"
        }
      ],
      "textures": [
        "Texture.breeze_wind"
      ],
      "uv_anim": {
        "offset": [
          "((Math.floor(query.life_time * 20.0) + query.frame_alpha) * 0.02)",
