{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.steveo_nimbus_king": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "overlay_color": {
        "r": "1.0",
        "g": "1.0",
        "b": "1.0",
        "a": "0.55"
      }
    },
    "controller.render.steveo_nimbus_king_eyes": {
