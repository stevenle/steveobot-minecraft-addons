{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "steveo:firework_burst",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 70
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(5, 9)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -4,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.7, 1.3)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 * (1 - variable.particle_age / variable.particle_lifetime)",
          "0.18 * (1 - variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.sin(variable.particle_random_1 * 360) * 0.5 + 0.5",
          "math.sin(variable.particle_random_1 * 360 + 120) * 0.5 + 0.5",
          "math.sin(variable.particle_random_1 * 360 + 240) * 0.5 + 0.5",
          1
        ]
      }
    }
  }
}
