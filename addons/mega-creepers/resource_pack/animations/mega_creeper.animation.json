{
  "format_version": "1.8.0",
  "animations": {
    "animation.steveo_mega_creeper.walk": {
      "loop": true,
      "bones": {
        "leg0": { "rotation": ["math.cos(query.modified_distance_moved * 38.17) * 80.0 * query.modified_move_speed", 0, 0] },
        "leg1": { "rotation": ["-math.cos(query.modified_distance_moved * 38.17) * 80.0 * query.modified_move_speed", 0, 0] },
        "leg2": { "rotation": ["-math.cos(query.modified_distance_moved * 38.17) * 80.0 * query.modified_move_speed", 0, 0] },
        "leg3": { "rotation": ["math.cos(query.modified_distance_moved * 38.17) * 80.0 * query.modified_move_speed", 0, 0] }
      }
    },
    "animation.steveo_mega_creeper.look_at_target": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0] }
      }
    },
    "animation.steveo_mega_creeper.fuse": {
      "loop": true,
      "bones": {
        "body": {
          "scale": [
            "1.0 + math.sin(query.life_time * 1440.0) * 0.04 + 0.12",
            "1.0 - math.sin(query.life_time * 1440.0) * 0.03",
            "1.0 + math.sin(query.life_time * 1440.0) * 0.04 + 0.12"
          ]
        }
      }
    },
    "animation.steveo_mega_creeper.charge": {
      "loop": true,
      "bones": {
        "head": { "rotation": [-35, "math.sin(query.life_time * 900.0) * 6.0", 0] },
        "body": { "rotation": [0, "math.sin(query.life_time * 1800.0) * 3.0", 0] }
      }
    },
    "animation.steveo_mega_creeper.recharge": {
      "loop": true,
      "bones": {
        "body": { "rotation": [12, 0, "math.sin(query.life_time * 120.0) * 6.0"] },
        "head": { "rotation": [25, "math.sin(query.life_time * 240.0) * 20.0", 0] }
      }
    }
  }
}
