{
  "namespace": "server_form",

  "long_form": {
    "type": "panel",
    "size": [0, 0],
    "controls": [
      {
        "vanilla_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": ["100% - 15px", 10],
          "$title_max_size": ["100% - 15px", 10],
          "size": [225, 200],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§u§n§c§r') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "steveo_uncraft_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": ["100% - 15px", 10],
          "$title_max_size": ["100% - 15px", 10],
          "size": [196, 156],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.steveo_uncraft_panel",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§u§n§c§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "steveo_uncraft_panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["100% - 8px", "100%"],
    "offset": [4, 2],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "collection_name": "form_buttons",
    "controls": [
      {
        "steveo_recipe_row": {
          "type": "panel",
          "size": ["100%", 58],
          "collection_name": "form_buttons",
          "controls": [
            {
              "steveo_input@server_form.steveo_slot": {
                "collection_index": 9,
                "size": [26, 26],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "offset": [14, 0]
              }
            },
            {
              "steveo_arrow": {
                "type": "image",
                "texture": "textures/ui/arrow_large",
                "size": [22, 15],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "offset": [52, 0]
              }
            },
            {
              "steveo_grid": {
                "type": "grid",
                "size": [54, 54],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "offset": [90, 0],
                "grid_dimensions": [3, 3],
                "maximum_grid_items": 9,
                "grid_item_template": "server_form.steveo_cell",
                "collection_name": "form_buttons"
              }
            }
          ]
        }
      },
      {
        "steveo_notes": {
          "type": "label",
          "size": ["100%", "default"],
          "color": "$main_header_text_color",
          "text": "#form_text"
        }
      },
      {
        "steveo_gap": {
          "type": "panel",
          "size": ["100%", 4]
        }
      },
      {
        "steveo_buttons": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": ["100%", 20],
          "collection_name": "form_buttons",
          "controls": [
            {
              "steveo_once@server_form.steveo_action": {
                "collection_index": 10
              }
            },
            {
              "steveo_button_gap": {
                "type": "panel",
                "size": [4, "100%"]
              }
            },
            {
              "steveo_all@server_form.steveo_action": {
                "collection_index": 11
              }
            }
          ]
        }
      }
    ]
  },

  "steveo_cell@server_form.steveo_slot": {
    "size": [18, 18]
  },

  "steveo_slot": {
    "type": "panel",
    "size": [18, 18],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "background": {
          "type": "image",
          "texture": "textures/ui/cell_image",
          "size": ["100%", "100%"],
          "layer": 1
        }
      },
      {
        "icon": {
          "type": "image",
          "size": [16, 16],
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "count": {
          "type": "label",
          "layer": 3,
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [-1, 0],
          "shadow": true,
          "color": [1, 1, 1],
          "text": "#form_button_text",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  "steveo_action@common_buttons.light_text_button": {
    "$pressed_button_name": "button.form_button_click",
    "size": ["50% - 2px", 20],
    "$button_text": "#form_button_text",
    "$button_text_binding_type": "collection",
    "$button_text_grid_collection_name": "form_buttons",
    "$button_text_max_size": ["100%", 20],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#form_button_text = ''))",
        "target_property_name": "#visible"
      }
    ]
  }
}
