{
  "format_version": "1.8.0",
  "animations": {
    "animation.steveo_tim.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.steveo_tim.walk": {
      "loop": true,
      "bones": {
        "rightLeg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 40.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leftLeg": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 40.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "rightArm": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 35.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 35.0 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.steveo_tim.attack": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "-math.sin(query.attack_time * 180.0) * 110.0",
            "math.sin(query.attack_time * 180.0) * -20.0",
            0
          ]
        },
        "body": {
          "rotation": [
            0,
            "math.sin(query.attack_time * 180.0) * 15.0",
            0
          ]
        }
      }
    },
    "animation.steveo_tim.sit": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            0,
            -10,
            0
          ]
        },
        "rightLeg": {
          "rotation": [
            -80,
            10,
            0
          ]
        },
        "leftLeg": {
          "rotation": [
            -80,
            -10,
            0
          ]
        },
        "rightArm": {
          "rotation": [
            -20,
            0,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            -20,
            0,
            0
          ]
        }
      }
    },
    "animation.steveo_tim.dance": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            0,
            "math.abs(math.sin(query.life_time * 360.0)) * 1.5",
            0
          ],
          "rotation": [
            0,
            "math.sin(query.life_time * 90.0) * 35.0",
            0
          ]
        },
        "waist": {
          "rotation": [
            0,
            0,
            "math.sin(query.life_time * 180.0) * 8.0"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 360.0) * 8.0",
            0,
            "math.sin(query.life_time * 180.0) * -10.0"
          ]
        },
        "rightArm": {
          "rotation": [
            "-160.0 + math.sin(query.life_time * 360.0) * 25.0",
            0,
            "math.sin(query.life_time * 180.0) * 25.0"
          ]
        },
        "leftArm": {
          "rotation": [
            "-160.0 - math.sin(query.life_time * 360.0) * 25.0",
            0,
            "math.sin(query.life_time * 180.0) * 25.0"
          ]
        },
        "rightLeg": {
          "rotation": [
            "math.max(0.0, math.sin(query.life_time * 180.0)) * -35.0",
            0,
            0
          ]
        },
        "leftLeg": {
          "rotation": [
            "math.max(0.0, -math.sin(query.life_time * 180.0)) * -35.0",
            0,
            0
          ]
        }
      }
    }
  }
}
