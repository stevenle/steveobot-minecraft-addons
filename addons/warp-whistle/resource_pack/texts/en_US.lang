## Strings for the Warp Whistle add-on.
## Client-side translations live in the resource pack; the behavior pack
## references them by key with RawMessage { translate: ... }.

item.steveo:warp_whistle.name=Warp Whistle

warp_whistle.hint=Use: open the warp menu. Crouch + use: set a waypoint where you stand. Home is always your bed; turn on Edit in the menu to rename, move, or delete waypoints.

## Main menu
warp_whistle.menu.title=Warp Whistle
warp_whistle.menu.home=Home (your bed)
warp_whistle.menu.home.none=Home §7(no bed yet)
warp_whistle.menu.set=Set a waypoint here
warp_whistle.menu.players=Players
warp_whistle.menu.waypoints=Waypoints §7(newest first)
warp_whistle.menu.edit=Edit waypoints
warp_whistle.menu.edit.hint=Rename, move, or delete waypoints right in this list. New names are saved when you close the menu.
warp_whistle.dim.nether=Nether
warp_whistle.dim.the_end=The End

## Set / rename
warp_whistle.set.title=New waypoint
warp_whistle.set.name=Name
warp_whistle.set.submit=Set waypoint
warp_whistle.set.done=Waypoint §e%s§r set at %s.
warp_whistle.set.full=The whistle cannot remember any more waypoints. Delete some first.
warp_whistle.set.empty=A waypoint needs a name.
warp_whistle.set.long=Names can be at most %s characters.
warp_whistle.set.duplicate=There is already a waypoint called §e%s§r.

## Edit (inline in the menu)
warp_whistle.edit.name=Name
warp_whistle.edit.by=Set by %s
warp_whistle.edit.move=§7  Move §e%s§7 here
warp_whistle.edit.delete=§7  Delete §e%s
warp_whistle.edit.restore=Undo: bring back §e%s
warp_whistle.rename.done=Renamed §e%s§r to §e%s§r.
warp_whistle.move.done=Moved §e%s§r to %s.
warp_whistle.delete.done=Deleted §e%s§r.
warp_whistle.restore.done=Brought back §e%s§r.
warp_whistle.gone=That waypoint no longer exists.

## Warping
warp_whistle.home.none=You have no bed yet. Sleep in one, then blow the whistle.
warp_whistle.warping=Whistling... hold on!
warp_whistle.cooldown=The whistle needs a moment to catch its breath.
warp_whistle.arrived=Whoosh! You are at §e%s§r.
warp_whistle.arrived.home=Whoosh! Home sweet home.
warp_whistle.arrived.player=Whoosh! You are with §e%s§r.
warp_whistle.player.gone=That player is no longer here.
warp_whistle.player.incoming=§e%s§r warped to you.
warp_whistle.failed=The wind fizzled out. Try again.

## Debug (/scriptevent steveo:warp ...)
warp_whistle.debug.given=A Warp Whistle has been placed in your inventory.
warp_whistle.debug.list=Waypoints (%s):
warp_whistle.debug.list.home= Home: %s
warp_whistle.debug.list.home.none= Home: no bed set
warp_whistle.debug.list.one= [%s] %s at %s (set by %s)
warp_whistle.debug.cleared=Removed %s waypoints.
warp_whistle.debug.demo=Playing the warp effect in place. If you see no sparkles or hear no whistle, the script is not running.
warp_whistle.debug.help=Usage: /scriptevent steveo:warp <give|list|clear|demo>
