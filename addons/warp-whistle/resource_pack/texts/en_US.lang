warp_whistle.menu.title=Warp Whistle
warp_whistle.menu.body=Where to?
warp_whistle.menu.home=Home (your bed)
warp_whistle.menu.home.none=Home §7(no bed yet)
warp_whistle.menu.set=Set a waypoint here
warp_whistle.menu.manage=Manage waypoints
warp_whistle.dim.nether=Nether
warp_whistle.dim.the_end=The End

