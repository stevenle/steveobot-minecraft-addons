{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "steveo:potato",
      "is_spawnable": false,
      "is_summonable": true
    },
    "component_groups": {
      "steveo:crossbow": {
        "minecraft:mark_variant": { "value": 0 }
      },
      "steveo:launcher": {
        "minecraft:mark_variant": { "value": 1 },
        "minecraft:scale": { "value": 1.8 }
      },
      "steveo:explosive": {
        "minecraft:variant": { "value": 1 }
      },
      "steveo:poison": {
        "minecraft:variant": { "value": 2 }
      },
      "steveo:fuse": {
        "minecraft:timer": {
          "time": 8,
          "looping": false,
          "time_down_event": { "event": "steveo:despawn" }
        }
      },
      "steveo:gone": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["steveo_potato", "inanimate"] },
      "minecraft:collision_box": { "width": 0.25, "height": 0.25 },
      "minecraft:physics": { "has_gravity": false, "has_collision": false },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:fire_immune": {},
      "minecraft:damage_sensor": {
        "triggers": [{ "cause": "all", "deals_damage": false }]
      },
      "minecraft:variant": { "value": 0 },
      "minecraft:mark_variant": { "value": 0 }
    },
    "events": {
      "minecraft:entity_spawned": { "add": { "component_groups": ["steveo:fuse"] } },
      "steveo:crossbow": { "add": { "component_groups": ["steveo:fuse", "steveo:crossbow"] } },
      "steveo:launcher": { "add": { "component_groups": ["steveo:fuse", "steveo:launcher"] } },
      "steveo:crossbow_explosive": {
        "add": { "component_groups": ["steveo:fuse", "steveo:crossbow", "steveo:explosive"] }
      },
      "steveo:launcher_explosive": {
        "add": { "component_groups": ["steveo:fuse", "steveo:launcher", "steveo:explosive"] }
      },
      "steveo:crossbow_poison": {
        "add": { "component_groups": ["steveo:fuse", "steveo:crossbow", "steveo:poison"] }
      },
      "steveo:launcher_poison": {
        "add": { "component_groups": ["steveo:fuse", "steveo:launcher", "steveo:poison"] }
      },
      "steveo:despawn": { "add": { "component_groups": ["steveo:gone"] } }
    }
  }
}
