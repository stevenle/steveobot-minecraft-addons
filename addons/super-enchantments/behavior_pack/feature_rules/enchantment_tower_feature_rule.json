{
  "format_version": "1.13.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "steveo:overworld_surface_enchantment_tower_feature",
      "places_feature": "steveo:enchantment_tower_feature"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": [
        { "test": "has_biome_tag", "operator": "==", "value": "overworld" },
        { "test": "has_biome_tag", "operator": "!=", "value": "ocean" },
        { "test": "has_biome_tag", "operator": "!=", "value": "deep" },
        { "test": "has_biome_tag", "operator": "!=", "value": "river" },
        { "test": "has_biome_tag", "operator": "!=", "value": "beach" }
      ]
    },
    "distribution": {
      "iterations": 1,
      "scatter_chance": 0.4,
      "x": { "distribution": "uniform", "extent": [0, 7] },
      "y": "query.heightmap(variable.worldx, variable.worldz) - 4",
      "z": { "distribution": "uniform", "extent": [0, 7] }
    }
  }
}
