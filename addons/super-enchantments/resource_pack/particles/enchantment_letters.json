{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "steveo:enchantment_letters",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/enchantment_letters"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.floor(12 + variable.emitter_random_1 * 36)"
      },
      "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": ["math.random(-1, 1)", "math.random(1.5, 3)", "math.random(-1, 1)"]
      },
      "minecraft:particle_initial_speed": "math.random(2.5, 6)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(-180, 180)",
        "rotation_rate": "math.random(-120, 120)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -7, 0],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "math.random(0.9, 1.8)" },
      "minecraft:particle_appearance_billboard": {
        "size": [0.28, 0.28],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 8,
          "uv": ["math.floor(variable.particle_random_1 * 16) * 8", 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.4": "#FFF1D8FF",
            "0.8": "#FFC77DFF",
            "1.0": "#005B84E8"
          }
        }
      }
    }
  }
}
