{
  "format_version": "1.8.0",
  "animations": {
    "animation.steveo_bowser.walk": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 20.0) * 30.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_r": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 20.0) * 30.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "arm_l": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 20.0) * 25.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "arm_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 20.0) * 25.0 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.steveo_bowser.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.steveo_bowser.tail": {
      "loop": true,
      "bones": {
        "tail": {
          "rotation": [
            0,
            "math.sin(query.life_time * 90.0) * 12.0",
            0
          ]
        }
      }
    }
  }
}
