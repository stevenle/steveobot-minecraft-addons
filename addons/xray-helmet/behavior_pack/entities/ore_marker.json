{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "steveo:ore_marker",
      "is_spawnable": false,
      "is_summonable": true
    },
    "component_groups": {
      "steveo:v_diamond": { "minecraft:variant": { "value": 0 } },
      "steveo:v_ancient_debris": { "minecraft:variant": { "value": 1 } },
      "steveo:v_emerald": { "minecraft:variant": { "value": 2 } },
      "steveo:v_gold": { "minecraft:variant": { "value": 3 } },
      "steveo:v_lapis": { "minecraft:variant": { "value": 4 } },
      "steveo:v_redstone": { "minecraft:variant": { "value": 5 } },
      "steveo:fuse": {
        "minecraft:timer": {
          "time": 6,
          "looping": false,
          "time_down_event": { "event": "steveo:despawn" }
        }
      },
      "steveo:gone": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["steveo_marker", "inanimate"] },
      "minecraft:collision_box": { "width": 0.01, "height": 0.01 },
      "minecraft:physics": { "has_gravity": false, "has_collision": false },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:fire_immune": {},
      "minecraft:damage_sensor": {
        "triggers": [{ "cause": "all", "deals_damage": false }]
      }
    },
    "events": {
      "minecraft:entity_spawned": { "add": { "component_groups": ["steveo:fuse"] } },
      "steveo:diamond": { "add": { "component_groups": ["steveo:fuse", "steveo:v_diamond"] } },
      "steveo:ancient_debris": { "add": { "component_groups": ["steveo:fuse", "steveo:v_ancient_debris"] } },
      "steveo:emerald": { "add": { "component_groups": ["steveo:fuse", "steveo:v_emerald"] } },
      "steveo:gold": { "add": { "component_groups": ["steveo:fuse", "steveo:v_gold"] } },
      "steveo:lapis": { "add": { "component_groups": ["steveo:fuse", "steveo:v_lapis"] } },
      "steveo:redstone": { "add": { "component_groups": ["steveo:fuse", "steveo:v_redstone"] } },
      "steveo:refresh": {
        "sequence": [
          { "remove": { "component_groups": ["steveo:fuse"] } },
          { "add": { "component_groups": ["steveo:fuse"] } }
        ]
      },
      "steveo:despawn": { "add": { "component_groups": ["steveo:gone"] } }
    }
  }
}
